# Copy to .env and change the password. Never commit .env.

# Used by docker-compose to initialise the local Postgres container
POSTGRES_USER=fuelwatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fuelwatch
POSTGRES_PORT=5432

# Used by the pipeline (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://fuelwatch:change-me@localhost:5432/fuelwatch
